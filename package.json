{
  "name": "relics-v4-starter",
  "version": "0.1.0",
  "private": true,
  "description": "The RELICS creator kit: author a fully on-chain generative art collection locally, validate it against the same schema the launchpad importer runs, and export one canonical .relics bundle. Includes a Uniswap v4 hook starter for building a launch from scratch. Not affiliated with Uniswap, OpenZeppelin, or any production collection.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "web:dev": "npm run dev --workspace @relics-v4-starter/web",
    "web:build": "npm run build --workspace @relics-v4-starter/web",
    "web:lint": "npm run lint --workspace @relics-v4-starter/web",
    "web:typecheck": "npm run typecheck --workspace @relics-v4-starter/web",
    "web:test": "npm run test --workspace @relics-v4-starter/web",
    "web:test:unit": "npm run test:unit --workspace @relics-v4-starter/web",
    "secrets:scan": "bash scripts/secret-scan.sh",
    "reserved:check": "node scripts/check-reserved-terms.mjs",
    "reserved:controls": "node scripts/check-reserved-terms.mjs --controls",
    "kit": "node packages/creator-cli/bin/relics.js",
    "kit:status": "node packages/creator-cli/bin/relics.js status",
    "kit:doctor": "node packages/creator-cli/bin/relics.js doctor",
    "kit:test": "node packages/project-schema/test/run.mjs && node --test packages/creator-cli/test/*.test.mjs",
    "kit:templates": "node scripts/check-templates.mjs",
    "kit:lifecycle": "node scripts/check-template-lifecycle.mjs",
    "kit:agent-projects": "node scripts/check-agent-projects.mjs",
    "kit:readme": "node scripts/test-readme-quickstart.mjs",
    "kit:gates:selftest": "node scripts/verify-gates-fail.mjs",
    "kit:traits": "node scripts/check-trait-art-correspondence.mjs",
    "kit:traits:controls": "node scripts/check-trait-art-correspondence.mjs --controls",
    "kit:launch-claims": "node scripts/check-launch-claims.mjs",
    "kit:launch-claims:controls": "node scripts/check-launch-claims.mjs --controls",
    "ci:gates": "node scripts/check-ci-gates.mjs",
    "ci:gates:controls": "node scripts/check-ci-gates.mjs --controls",
    "docs:assets": "node scripts/generate-doc-assets.mjs",
    "docs:assets:check": "node scripts/generate-doc-assets.mjs --check",
    "docs:links": "node scripts/check-links.mjs",
    "docs:links:external": "node scripts/check-links.mjs --external",
    "kit:fixtures": "node packages/project-schema/fixtures/build.mjs",
    "kit:acv1": "node packages/project-schema/fixtures/acv1/build.mjs",
    "kit:economics": "node scripts/check-economics.mjs",
    "kit:protection": "node scripts/check-launch-protection.mjs",
    "kit:protection:controls": "node scripts/check-launch-protection.mjs --controls",
    "kit:parity": "node scripts/check-schema-parity.mjs",
    "kit:parity:update": "node scripts/check-schema-parity.mjs --update",
    "kit:parity:selftest": "node scripts/check-schema-parity.mjs --self-test",
    "kit:compat": "node scripts/build-production-compat.mjs",
    "kit:deployments:check": "node scripts/sync-deployments.mjs --check",
    "kit:deployments:sync": "node scripts/sync-deployments.mjs --sync",
    "export:manifest": "node scripts/gen-manifest.mjs",
    "export:manifest:check": "node scripts/gen-manifest.mjs --check"
  }
}
