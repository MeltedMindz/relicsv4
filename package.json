{
  "name": "relics-v4-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Educational starter for fully on-chain generative art powered by Uniswap v4 hooks. Not audited. Not affiliated with Uniswap, OpenZeppelin, or any production collection.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "web:dev": "npm run dev --workspace @relics-v4-starter/web",
    "web:build": "npm run build --workspace @relics-v4-starter/web",
    "web:lint": "npm run lint --workspace @relics-v4-starter/web",
    "web:typecheck": "npm run typecheck --workspace @relics-v4-starter/web",
    "web:test": "npm run test --workspace @relics-v4-starter/web",
    "web:test:unit": "npm run test:unit --workspace @relics-v4-starter/web",
    "secrets:scan": "bash scripts/secret-scan.sh",
    "kit": "node packages/creator-cli/bin/relics.js",
    "kit:status": "node packages/creator-cli/bin/relics.js status",
    "kit:test": "node packages/project-schema/test/run.mjs",
    "kit:templates": "node scripts/check-templates.mjs",
    "kit:fixtures": "node packages/project-schema/fixtures/build.mjs",
    "kit:acv1": "node packages/project-schema/fixtures/acv1/build.mjs",
    "kit:economics": "node scripts/check-economics.mjs",
    "export:manifest": "node scripts/gen-manifest.mjs",
    "export:manifest:check": "node scripts/gen-manifest.mjs --check",
    "reserved:check": "node scripts/check-reserved-terms.mjs",
    "reserved:controls": "node scripts/check-reserved-terms.mjs --controls",
    "kit:protection": "node scripts/check-launch-protection.mjs",
    "kit:protection:controls": "node scripts/check-launch-protection.mjs --controls"
  }
}
