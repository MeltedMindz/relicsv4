# Generated art previews (regenerate with the GenerateExamples script)
output/examples/*.svg

# Playwright
apps/web/playwright-report/
apps/web/test-results/
test-results/

# Local env files and operator secrets. Only the *.example templates are tracked.
.env
.env.*
!.env.example
apps/web/.env.local
apps/web/.env*.local

# Wallet / key material must NEVER be committed.
*.wallet
*.wallet.json
*.mnemonic
*.private-key
*.secret
*.pem
*.keystore
keystore/
keystores/
wallets/

# OS / editor
.DS_Store
.idea/
.vscode/

# built output of the public launch SDK (regenerated by `npm run launch:build`)
packages/launch-sdk/dist/
packages/agent-flow/dist/
