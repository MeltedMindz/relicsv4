# relics-v4-starter web app — PUBLIC config template.
# Copy to `.env.local` and fill in. ONLY NEXT_PUBLIC_* values belong here; they are public by
# definition and are inlined into the browser bundle. NEVER put a private key, mnemonic, or any
# signing secret in this file or in your hosting provider's environment. The core flows need no
# server secret at all.

# Target chain id. Defaults to local Anvil (31337) if unset.
NEXT_PUBLIC_CHAIN_ID=31337

# Public RPC endpoint for reads. For local dev this is your Anvil node.
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Your deployed contract addresses. Leave blank to keep the app in its fail-closed
# "not configured" state (it will never invent a placeholder address).
NEXT_PUBLIC_TOKEN_ADDRESS=
NEXT_PUBLIC_NFT_ADDRESS=
NEXT_PUBLIC_HOOK_ADDRESS=
NEXT_PUBLIC_RENDERER_ADDRESS=

# Canonical pool id (bytes32), optional.
NEXT_PUBLIC_POOL_ID=
