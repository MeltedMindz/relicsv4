# relics-v4-starter — root env template (names + placeholders ONLY).
#
# Copy to `.env` (gitignored) and fill values LOCALLY. NEVER commit a populated env file, and
# NEVER paste a private key, mnemonic, or wallet JSON into a hosting provider's environment.
# The web app and the default test suite need NONE of these; they are only for broadcasting
# deployment scripts and for opt-in fork tests.

# --- RPC endpoints (no embedded API keys in committed files) ---
MAINNET_RPC_URL=
SEPOLIA_RPC_URL=

# --- Broadcast secret (operator machine only; keep out of Vercel/Netlify) ---
DEPLOYER_PRIVATE_KEY=
# Optional, if the hook owner differs from the deployer for the one-shot pool bind.
HOOK_OWNER_PRIVATE_KEY=

# --- Uniswap v4 infrastructure for your target chain ---
# Look these up in the official Uniswap deployments docs; this repo ships no baked-in address book.
POOL_MANAGER=
POSITION_MANAGER=
PERMIT2=
WETH=

# --- Deployment inputs (addresses you control) ---
INITIAL_HOLDER=
HOOK_OWNER=
TREASURY=
LP_RECIPIENT=
# Canonical dead address for entombing fees, if you choose that policy.
ENTOMBMENT=0x000000000000000000000000000000000000dEaD

# --- Collection identity (keep in sync with config/collection.config.ts) ---
# All optional: unset uses the neutral sample defaults, so the sample deploys with no edits.
COLLECTION_TOKEN_NAME=
COLLECTION_TOKEN_SYMBOL=
COLLECTION_TOKEN_SUPPLY=
COLLECTION_NFT_NAME=
COLLECTION_NFT_SYMBOL=
COLLECTION_MAX_NFT_SUPPLY=
# Which shipped art system to deploy: sigil | strata | orbital
RENDERER_STYLE=sigil

# --- Pool parameters (fee/spacing default to 3000 / 60 if unset) ---
POOL_FEE=
TICK_SPACING=
LAUNCH_TICK=
LIQUIDITY=

# --- Filled AFTER deployment (from confirmed receipts / on-chain reads), used by verify scripts ---
TOKEN=
HOOK=
RENDERER=
NFT=
POSITION_ID=
